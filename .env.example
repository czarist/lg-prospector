# --- LLM (LiteLLM OpenAI-compatible) ---
MODEL=local-main
BASE_URL=http://localhost:4000/v1
API_KEY=dummy

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=lg_prospector
MYSQL_USER=lucas
MYSQL_PASSWORD=lucas123

# --- Redis ---
REDIS_URL=redis://:7N4bLX83VQc6o6yZJTjJUctTdrpXNEZ@localhost:6379/0

# --- EspoCRM (preferir ESPO_*) ---
ESPO_CRM_URL=https://trentincrm.com.br/api/v1
# API Key do usuário API, OU "usuario:senha" para Basic/Espo-Authorization
ESPO_CRM_TOKEN=

# Fallback legado (usado se ESPO_CRM_* vazio)
CRM_URL=https://trentincrm.com.br/api/v1
CRM_USER=admin
CRM_PASSWORD=

# --- SMTP ---
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=prospeccao@trentin.com.br
SMTP_USE_TLS=true

# --- IMAP (bounces / NDR) — opcional; se vazio reusa SMTP_USER/PASSWORD
# Zoho Mail Pro: imappro.zoho.com | Zoho free: imap.zoho.com
# IMAP_HOST=imappro.zoho.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# IMAP_USE_SSL=true

# --- App ---
APP_NAME=lg-prospector
APP_ENV=development
LOG_LEVEL=INFO
TEMPLATES_DIR=templates
API_HOST=0.0.0.0
API_PORT=8200
# Relativo (logs) = pasta no projeto. Absoluto = HD.
LOGS_DIR=/storage/lg-prospector/logs

# --- Providers / Search ---
# auto = Serper se a key existir, senão DDG. serper = só Serper (sem fallback).
SEARCH_BACKEND=auto
SERPER_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# Firecrawl não é mais necessário (scrape local)
FIRECRAWL_API_KEY=

# --- Scraping local (substitui Firecrawl) ---
SCRAPE_USE_PLAYWRIGHT=true
SCRAPE_MAX_PAGES=3
SCRAPE_TIMEOUT_SECONDS=15

# --- Caçada: fragmentação (protege CPU e Qwen local) ---
SEARCH_CONCURRENCY=1
SEARCH_MIN_INTERVAL_SECONDS=0.9
SEARCH_MAX_BACKENDS=2          # 1=só DDG html, 2=+lib, 3=+bing
ENRICH_CONCURRENCY=1
ENRICH_BATCH_PAUSE_SECONDS=0.4
ENRICH_MAX_DOMAIN_QUERIES=3
ENRICH_PLAYWRIGHT=false        # true só se precisar de sites JS
ENRICH_VERIFY_EMAIL_DNS=true   # confere MX/A do domínio do e-mail antes de aceitar o lead
SCRAPE_CONCURRENCY=2
PLAYWRIGHT_CONCURRENCY=1
DISCOVER_OVERFETCH_FACTOR=5
# LLM local NÃO é usado na caçada por padrão (regex/scrape bastam)
HUNT_USE_LLM=false
LLM_CONCURRENCY=1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=120
DISCOVER_MIN_LLM_SCORE=40   # keep=true do LLM só conta se score >= isso

# --- Dispatch e-mail ---
EMAIL_COOLDOWN_DAYS=4
DISPATCH_DELAY_SECONDS=8.0
DISPATCH_DELAY_JITTER_SECONDS=0
EMAIL_HOURLY_LIMIT=0
EMAIL_DAILY_LIMIT=0

# --- Mailman (disparo separado do hunt) ---
MAILMAN_BATCH_SIZE=2
MAILMAN_INTERVAL_MIN_SECONDS=120
MAILMAN_INTERVAL_MAX_SECONDS=300
MAILMAN_INTRA_BATCH_MIN_SECONDS=20
MAILMAN_INTRA_BATCH_MAX_SECONDS=75

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60


