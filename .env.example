# --- LLM (LiteLLM OpenAI-compatible) ---
MODEL=local-main
BASE_URL=http://localhost:4000/v1
API_KEY=dummy

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=lg_prospector
MYSQL_USER=lucas
MYSQL_PASSWORD=lucas123

# --- Redis ---
REDIS_URL=redis://:7N4bLX83VQc6o6yZJTjJUctTdrpXNEZ@localhost:6379/0

# --- EspoCRM (preferir ESPO_*) ---
ESPO_CRM_URL=https://trentincrm.com.br/api/v1
# API Key do usuário API, OU "usuario:senha" para Basic/Espo-Authorization
ESPO_CRM_TOKEN=

# Fallback legado (usado se ESPO_CRM_* vazio)
CRM_URL=https://trentincrm.com.br/api/v1
CRM_USER=admin
CRM_PASSWORD=

# --- SMTP ---
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=prospeccao@trentin.com.br
SMTP_USE_TLS=true

# --- App ---
APP_NAME=lg-prospector
APP_ENV=development
LOG_LEVEL=INFO
TEMPLATES_DIR=templates
API_HOST=0.0.0.0
API_PORT=8200

# --- Providers / Search ---
SERPER_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# Firecrawl não é mais necessário (scrape local)
FIRECRAWL_API_KEY=

# --- Scraping local (substitui Firecrawl) ---
SCRAPE_USE_PLAYWRIGHT=true
SCRAPE_MAX_PAGES=3
SCRAPE_TIMEOUT_SECONDS=15

# --- Caçada: fragmentação (protege CPU e Qwen local) ---
SEARCH_CONCURRENCY=1
SEARCH_MIN_INTERVAL_SECONDS=0.9
SEARCH_MAX_BACKENDS=2          # 1=só DDG html, 2=+lib, 3=+bing
ENRICH_CONCURRENCY=1
ENRICH_BATCH_PAUSE_SECONDS=0.4
ENRICH_MAX_DOMAIN_QUERIES=3
ENRICH_PLAYWRIGHT=false        # true só se precisar de sites JS
ENRICH_VERIFY_EMAIL_DNS=true   # confere MX/A do domínio do e-mail antes de aceitar o lead
SCRAPE_CONCURRENCY=2
PLAYWRIGHT_CONCURRENCY=1
DISCOVER_OVERFETCH_FACTOR=5
# LLM local NÃO é usado na caçada por padrão (regex/scrape bastam)
HUNT_USE_LLM=false
LLM_CONCURRENCY=1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=120
DISCOVER_MIN_LLM_SCORE=40   # keep=true do LLM só conta se score >= isso

# --- Dispatch e-mail ---
EMAIL_COOLDOWN_DAYS=4
DISPATCH_DELAY_SECONDS=2.0

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

SEARCH_BACKEND=free
SERPER_API_KEY=""# opcional se SEARCH_BACKEND=serper|auto
